# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# oh-my-claudecode (도구가 만드는 로컬 세션 상태·프로젝트 메모리)
/.omc/

# Stitch 디자인 초안 (2.3MB). 참고 자료라 저장소에 넣지 않는다.
# 커밋 여부와 별개로 여기 반드시 있어야 한다 — Tailwind v4 는 프로젝트 안을
# 자동으로 훑되 .gitignore 는 건너뛴다. 빼 두면 초안 HTML 의 클래스가
# 프로덕션 CSS 에 그대로 딸려 들어간다(실측 85K → 68K).
/stitch_/
