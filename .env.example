# 이 파일은 "어떤 값이 필요한지"만 알려주는 템플릿입니다. 실제 값은 넣지 마세요.
# 실제 값은 .env.local 에 넣고, .env.local 은 절대 커밋하지 않습니다.

# 카카오 디벨로퍼스 (https://developers.kakao.com) — 내 애플리케이션 > 앱 키
NEXT_PUBLIC_KAKAO_MAP_KEY=   # JavaScript 키 (지도 SDK, 브라우저에 노출됨)
KAKAO_REST_API_KEY=          # REST API 키 (주소→좌표 지오코딩, 서버 전용)

# 공공데이터포털 (https://www.data.go.kr) — 전국공중화장실표준데이터 인증키
DATA_GO_KR_SERVICE_KEY=      # 일반 인증키(Decoding)

# Supabase (https://supabase.com) — Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # DB 전체 권한. 데이터 적재 스크립트 전용, Vercel에 등록하지 않음
